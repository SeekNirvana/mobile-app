# SeekNirvana Environment Variables
# Copy this file to .env and fill in your actual values
# NOTE: For production builds, use --dart-define instead of .env for security

# ============================================================================
# REOWN APPKIT CONFIGURATION (Required for Wallet Connect)
# ============================================================================

# Get your Project ID from https://cloud.reown.com/
# This is required for Wallet Connect to work
PROJECT_ID=your_reown_project_id_here

# Optional: Custom relay URL (defaults to Reown's relay)
# RELAY_URL=wss://relay.walletconnect.com

# ============================================================================
# SOLANA CONFIGURATION
# ============================================================================

# Solana RPC endpoint (defaults to public mainnet)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Token mint address for $NIRV (if using custom token)
# NIRV_TOKEN_MINT=your_token_mint_address

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================

# API base URL for authentication and rewards backend
# Use http://localhost:8080 for local development
# Use your production URL for release builds
API_BASE_URL=http://localhost:8080

# API key for backend authentication (if required)
# API_KEY=your_api_key_here

# ============================================================================
# DEBUG / DEVELOPMENT
# ============================================================================

# Enable debug logging (true/false)
# DEBUG_MODE=false

# Use testnet instead of mainnet for Solana (true/false)
# USE_TESTNET=false
